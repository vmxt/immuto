module Immuto
  VERSION: String

  class Error < StandardError
  end

  class UnknownAttributeError < Error
    def initialize: (untyped attribute) -> void
  end

  class MissingAttributeError < Error
    def initialize: (untyped attribute) -> void
  end

  class NestedUpdateError < Error
    def initialize: (untyped attribute) -> void
  end

  class ValidationError < Error
    def initialize: (untyped attribute, ?String? message) -> void
  end

  class DiffError < Error
    def initialize: (untyped left, untyped right) -> void
  end

  class MergeError < Error
    def initialize: (untyped left, untyped right) -> void
  end

  class SnapshotError < Error
  end

  class Snapshot
    attr_reader object_class: Class
    attr_reader data: Hash[untyped, untyped]

    def initialize: (object_class: Class, data: Hash[untyped, untyped]) -> void
    def to_h: () -> Hash[untyped, untyped]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
  end

  class Builder
    attr_reader object_class: Class

    def initialize: (object_class: Class, ?values: Hash[untyped, untyped]) -> void
    def apply: () { (Immuto::Builder) -> untyped } -> Immuto::Builder
             | () { () -> untyped } -> Immuto::Builder
    def values: () -> Hash[Symbol, untyped]
    def changes: () -> Hash[Symbol, untyped]
    def set: (String | Symbol name, untyped value) -> untyped
  end

  class Attribute
    attr_reader name: Symbol

    def initialize: (name: String | Symbol, ?default: untyped, ?validator: untyped, ?message: String?) -> void
    def default?: () -> bool
    def default_value: () -> untyped
    def validate: (untyped value) -> nil
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
  end

  module Immutable
    def with: (**untyped changes) -> instance
    def with_path: (*untyped path_and_value) -> instance
    def to_h: () -> Hash[Symbol, untyped]
    def to_json: (*untyped args) -> String
    def diff: (untyped other) -> Hash[Symbol, untyped]
    def merge: (untyped other) -> instance
    def snapshot: () -> Immuto::Snapshot
    def changes_since: (Immuto::Snapshot snapshot) -> Hash[Symbol, untyped]
    def rebuild: () { (Immuto::Builder) -> untyped } -> instance
               | () { () -> untyped } -> instance
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String

    module ClassMethods
      def attribute: (String | Symbol name, ?default: untyped, ?validate: untyped, ?message: String?) -> Immuto::Attribute
      def attributes: () -> Array[Immuto::Attribute]
      def build: () { (Immuto::Builder) -> untyped } -> untyped
               | () { () -> untyped } -> untyped
      def from_h: (untyped attributes) -> untyped
      def restore: (Immuto::Snapshot snapshot) -> untyped
      def attribute_names: () -> Array[Symbol]
    end
  end
end
